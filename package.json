{
  "name": "crossway-collective",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf .next",
    "dev": "npm run clean && next dev",
    "dev:poll": "WATCHPACK_POLLING=true next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "compress:newimages": "node scripts/compress-newimages.cjs --force",
    "compress:newimages:dry": "node scripts/compress-newimages.cjs --dry-run",
    "apply:brand-images": "node scripts/apply-brand-images.cjs"
  },
  "dependencies": {
    "framer-motion": "^11.18.0",
    "next": "^14.2.35",
    "next-intl": "^3.26.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.85.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "sharp": "^0.35.3",
    "typescript": "^5.8.2"
  }
}
